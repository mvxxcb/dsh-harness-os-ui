{
  "name": "dsh-harness-os-ui",
  "version": "0.5.0",
  "description": "HARNESS OS shell chrome for the DeepSeek Harness Web UI: frame corner marks, drafting guides, HUD edge line — plus a full-fidelity preview of the HOME / SETTINGS design system.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ui",
    "hud",
    "shell-chrome",
    "design-system"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "ui",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/check.mjs"
  }
}
